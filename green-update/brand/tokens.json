{
  "color": {
    "canopy": { "value": "#265B42", "use": "Primary green: hero stage, mark, large fields" },
    "paper": { "value": "#F1F2EC", "use": "Default ground; text on green and ink" },
    "ink": { "value": "#121C17", "use": "Text; control rail; studio sections" },
    "fern": { "value": "#CFDCCF", "use": "Quiet fills; secondary text on green" },
    "live": { "value": "#F0562B", "use": "Signal only (live, primary CTA). Ink text on it, never white." },
    "white": { "value": "#FFFFFF", "use": "Cards, table and form surfaces on paper" },
    "stone": { "value": "#4F5A54", "use": "Secondary text on paper/white (6.4:1)" },
    "moss": { "value": "#34413A", "use": "Body text on fern; hairlines on ink" },
    "sage": { "value": "#A9B8AE", "use": "Secondary text on ink" },
    "lichen": { "value": "#8FA396", "use": "Tertiary labels on ink; input underline" },
    "mint": { "value": "#9DB8A6", "use": "De-emphasized large text on ink" },
    "line": { "value": "#D9DCD3", "use": "Hairlines on paper/white" },
    "lineStrong": { "value": "#C3C8BE", "use": "Stronger hairlines on paper" },
    "lineGreen": { "value": "#4E7461", "use": "Hairlines on canopy green" },
    "railBorder": { "value": "#4E5F55", "use": "Hamburger button border on ink" },
    "field": { "value": "#1B2721", "use": "Form input fill on ink" },
    "offAir": { "value": "#5B6A61", "use": "Footer off-air dot" }
  },
  "colorProportion": { "paper": 45, "canopy": 30, "ink": 17, "fern": 6, "live": 2 },
  "font": {
    "family": "Schibsted Grotesk",
    "fallback": "'Helvetica Neue', Arial, sans-serif",
    "weights": [400, 500, 600, 700, 800],
    "source": "brand/fonts (variable woff2, SIL OFL 1.1)"
  },
  "type": {
    "displayXL": { "size": "clamp(56px, 8.4vw, 128px)", "lineHeight": 0.9, "tracking": "-0.05em", "weight": 800 },
    "displayL": { "size": "clamp(44px, 5.5vw, 84px)", "lineHeight": 0.9, "tracking": "-0.05em", "weight": 800 },
    "displayM": { "size": "clamp(40px, 5vw, 72px)", "lineHeight": 0.92, "tracking": "-0.05em", "weight": 800 },
    "displayS": { "size": "clamp(32px, 4vw, 56px)", "lineHeight": 0.98, "tracking": "-0.045em", "weight": 800 },
    "lead": { "size": "clamp(19px, 1.7vw, 24px)", "lineHeight": 1.4, "weight": 400 },
    "body": { "size": "18px", "lineHeight": 1.5, "weight": 400 },
    "small": { "size": "16px", "lineHeight": 1.5, "weight": 400 },
    "label": { "size": "15px", "weight": 600 },
    "meta": { "size": "14px", "weight": 600 },
    "wordmark": { "tracking": "-0.045em", "weight": 800, "case": "lowercase" }
  },
  "layout": {
    "container": "1240px",
    "gutter": "clamp(16px, 4vw, 48px)",
    "sectionY": "clamp(56px, 8vw, 104px)",
    "splitBreakpoint": "960px",
    "split": "stage flex: 2 1 640px; rail flex: 1 1 320px (exact 2/3 : 1/3)",
    "hitTarget": "44px",
    "radius": "0"
  }
}
