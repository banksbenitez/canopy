---
import Base from '../layouts/Base.astro';
import SplitHero from '../components/SplitHero.astro';
import Scrubber from '../components/Scrubber.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import { STAGES } from '../data/stages';
import { STEPS } from '../data/steps';

const numbered = STEPS.map((step, i) => ({ ...step, n: i + 1 }));

const SECTIONS = STAGES.map((stage) => {
  const steps = numbered.filter((step) => step.stage === stage.id);
  const first = steps[0].n;
  const last = steps[steps.length - 1].n;
  return {
    ...stage,
    steps,
    scrubberTime: first === last ? `Step ${first}` : `Steps ${first}–${last}`,
    tone: stage.id === 'during' ? 'ink' : 'paper',
  } as const;
});
const PCT = { before: 15, during: 50, after: 78 };

const SETUP = [
  ['Onboarding', 'Your audience, goals and brand.'],
  ['Branded pages', 'Landing and registration templates.'],
  ['Zoom Webinar', 'Configured for your events.'],
  ['Email and reporting', 'Workflows and reporting infrastructure.'],
];
---
<Base
  title="How it works — Canopy"
  description="The same six-step process for every webinar, from kickoff 45–60 days out to follow-up within 48 hours and a report within a week."
  path="/how-it-works"
>
  <SplitHero current="/how-it-works">
    <div class="hero-body">
      <h1 class="hero-title">How it works.</h1>
      <p class="hero-lead">The same process for every webinar. You'll always know what we need from you and by when.</p>
    </div>
    <span slot="meta" class="hero-meta">Webinars-as-a-service for professional-services firms</span>

    <div slot="rail" class="rail-list">
      <span class="rail-label">Chapters</span>
      {numbered.map((step) => (
        <a href={`#step-${step.n}`} class="chapter">
          <span class:list={['chapter-n', { live: step.stage === 'during' }]}>{step.n}</span>
          <span class="chapter-title">{step.title}</span>
        </a>
      ))}
    </div>
  </SplitHero>

  <main>
    {SECTIONS.map((section) => (
      <section id={section.id} class:list={['phase', section.tone]}>
        <div class="container section-stack">
          <Scrubber
            time={section.scrubberTime}
            label={section.name}
            pct={PCT[section.id]}
            tone={section.tone}
            live={section.id === 'during'}
          />
          <div class="phase-row">
            <div class="phase-intro">
              <span class="phase-name">{section.name}</span>
              <h2 class="tagline">{section.tagline}</h2>
              <div class="division">
                <p><strong>Canopy runs:</strong> <span>{section.canopyRuns}</span></p>
                <p><strong>You bring:</strong> <span>{section.youBring}</span></p>
              </div>
            </div>
            <ol class="steps" start={section.steps[0].n}>
              {section.steps.map((step) => (
                <li id={`step-${step.n}`} class="step">
                  <div class="step-head">
                    <span class="step-n">{step.n}</span>
                    <h3>{step.title}</h3>
                  </div>
                  <p class="step-text">{step.text}</p>
                  {step.items.length > 0 && (
                    <ul class="items">
                      {step.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    ))}

    <section id="setup" class="setup">
      <div class="container setup-stack">
        <Scrubber time="Month 0" label="The setup" pct={92} tone="fern" />
        <div class="setup-intro">
          <h2 class="display-m">Before your first webinar.</h2>
          <p>A one-time setup builds the system every month runs on.</p>
        </div>
        <ol class="setup-steps">
          {SETUP.map(([title, text], i) => (
            <li>
              <span class="setup-n">{i + 1}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Closing />
  </main>

  <Footer current="/how-it-works" />
</Base>

<style>
  ol, ul { list-style: none; margin: 0; padding: 0; }

  /* Rail: chapters */
  .chapter {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--moss);
    color: var(--paper);
    text-decoration: none;
    align-items: baseline;
  }
  .chapter:last-child { border-bottom: 1px solid var(--moss); }
  .chapter-n { font-size: var(--text-label); color: var(--lichen); font-weight: 600; }
  .chapter-n.live { color: var(--live); }
  .chapter-title { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }

  /* Stage sections */
  .phase {
    --intro: var(--moss);
    --desc: var(--stone);
    --rule: var(--line-strong);
    --rule-heavy: var(--ink);
    --box: var(--white);
    --box-border: var(--line);
    --muted: var(--stone);
  }
  .phase.ink {
    background: var(--ink);
    color: var(--paper);
    --intro: var(--sage);
    --desc: var(--sage);
    --rule: var(--moss);
    --rule-heavy: var(--paper);
    --box: var(--field);
    --box-border: var(--moss);
    --muted: var(--sage);
  }
  .phase-row { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; }
  .phase-intro { flex: 1 1 340px; display: flex; flex-direction: column; gap: 20px; }
  .tagline { margin: 0; font-size: var(--display-s); line-height: 0.98; font-weight: 800; letter-spacing: var(--tracking-wordmark); }
  .phase-name { font-size: var(--text-label); font-weight: 600; color: var(--muted); }
  .ink .phase-name { color: var(--live); }

  .division {
    margin-top: 12px;
    padding: 18px 20px;
    background: var(--box);
    border: 1px solid var(--box-border);
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--text-label);
    line-height: 1.4;
  }
  .division p { margin: 0; display: grid; grid-template-columns: 108px 1fr; gap: 12px; }
  .division p:first-child strong { color: var(--muted); font-weight: 600; }

  .steps { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; }
  .step {
    padding: 22px 0 26px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-margin-top: 24px;
  }
  .step:first-child { border-top: 3px solid var(--rule-heavy); }
  .step:last-child { border-bottom: 1px solid var(--rule); }
  .step-head { display: grid; grid-template-columns: 40px 1fr; gap: 12px; align-items: baseline; }
  .step-n { font-size: var(--text-label); font-weight: 600; color: var(--muted); }
  .ink .step-n { color: var(--live); }
  .step h3 { margin: 0; font-size: clamp(22px, 2.2vw, 30px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }
  .step-text { margin: 0 0 0 52px; font-size: 17px; line-height: 1.5; color: var(--desc); max-width: 620px; }
  .items { margin-left: 52px; display: flex; flex-direction: column; }
  .items li {
    padding: 8px 0 8px 18px;
    position: relative;
    font-size: var(--text-small);
    line-height: 1.4;
  }
  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 18px;
    width: 8px;
    height: 2px;
    background: currentColor;
  }
  @media (max-width: 559px) {
    .step-head { grid-template-columns: 1fr; gap: 4px; }
    .step-text, .items { margin-left: 0; }
  }

  /* The setup */
  .setup { background: var(--fern); }
  .setup-stack { display: flex; flex-direction: column; gap: 40px; }
  .setup-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .setup-intro h2 { max-width: 680px; }
  .setup-intro p { margin: 0; max-width: 420px; font-size: var(--text-body); line-height: 1.5; color: var(--moss); }
  .setup-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    border-top: 3px solid var(--ink);
  }
  .setup-steps li { padding: 20px; display: flex; flex-direction: column; gap: 8px; border-left: 1px solid var(--sage); }
  .setup-steps li:first-child { padding-left: 0; border-left: 0; }
  .setup-n { font-size: var(--text-label); font-weight: 600; color: var(--moss); }
  .setup-steps h3 { margin: 0; font-size: 22px; font-weight: 700; }
  .setup-steps p { margin: 0; font-size: var(--text-small); line-height: 1.5; color: var(--moss); }
</style>
