---
import Base from '../layouts/Base.astro';
import SplitHero from '../components/SplitHero.astro';
import Scrubber from '../components/Scrubber.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../data/icons';
import { STAGES } from '../data/stages';
import { STEPS } from '../data/steps';
import { FAQ } from '../data/faq';
import { PRICE_HEADLINE, PRICE_SUBHEAD, FINE_PRINT, SETUP_INCLUDES, MONTHLY } from '../data/pricing';

const COMPARISON = [
  ['Webinars happen when someone has time', 'One webinar every month, on schedule'],
  ['Senior people handle logistics and AV', 'Your team presents, then goes back to client work'],
  ['Follow-up goes out days later, if at all', 'Follow-up with the recording within 48 hours'],
  ['Attendee list stays in a Zoom export', 'Attendee and registration data handed off for your CRM'],
  ['The recording sits in a folder', 'Clips, a transcript, newsletter material and a video library'],
  ['No clear read on what worked', 'An analytics report within a week'],
];

const HERO_VALUES = [
  'More attendees at every session',
  'More leads and content from each one',
  "Far less of your team's time on logistics",
];

const STAGE_ICONS: Record<string, IconName> = { before: 'registrants', during: 'live-stream', after: 'analytics-report' };

const ASSETS: { icon: IconName; name: string; text: string }[] = [
  { icon: 'audience-data', name: 'Data.', text: 'The attendee and registration list, ready for your CRM and email platform, plus an analytics report.' },
  { icon: 'newsletter', name: 'Follow-up.', text: 'Emails with the recording, transcript and highlights, built around your call to action.' },
  { icon: 'clips', name: 'Clips.', text: 'Short highlights for LinkedIn, short-form video, email and your site.' },
  { icon: 'transcript', name: 'Newsletter material.', text: 'Clips and the transcript, ready for your editorial team to write up or link.' },
  { icon: 'video-library', name: 'Library.', text: 'Every webinar and highlight in one evergreen place.' },
];

const FIT = [
  'Webinars have already led to client conversations or new work',
  "They happen less often than you'd like, because the logistics fall on busy people",
  'Recordings and attendee lists rarely get used after the event',
];
---
<Base
  title="Canopy — More return from every webinar"
  description="Canopy runs your webinars from registration through follow-up, so each one brings in more leads, content and data while taking less of your team's time."
  path="/"
>
  <SplitHero id="top" current="/" minHeight={780}>
    <div class="hero-body home-hero">
      <h1 class="hero-title">More return from every webinar.</h1>
      <p class="hero-lead">Canopy runs the work before, during, and after each webinar, from registration and reminders to production and follow-up.</p>
      <ul class="hero-values">
        {HERO_VALUES.map((value) => (
          <li><svg class="hero-check" width="18" height="14" viewBox="0 0 16 12" aria-hidden="true"><path d="M1.5 6.5 L6 10.5 L14.5 1.5" fill="none" stroke="currentColor" stroke-width="2.5" /></svg><span>{value}</span></li>
        ))}
      </ul>
      <div class="hero-ctas">
        <a href="/book" class="btn btn-live btn-lg">Book a 20-minute call</a>
        <a href="#how-it-works" class="text-cta hero-link">See how it works</a>
      </div>
    </div>

    <div slot="rail" class="rail-list">
    <ul class="stage-card icons-ink">
      {STAGES.map((stage) => (
        <li>
          <a href={`/how-it-works#${stage.id}`} class="stage-row">
            <Icon name={STAGE_ICONS[stage.id]} size={40} />
            <span class="stage-text">
              <span class="stage-name">{stage.name}.</span>
              <span class="stage-summary">{stage.summary}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    </div>
  </SplitHero>

  <main>
    <!-- 2. The math -->
    <section id="the-math" class="band light">
    <div class="container section-stack">
      <Scrubber time="01:00" pct={12} />
      <div class="intro">
        <h2 class="display-m intro-title">Most webinars return less than they could.</h2>
        <div class="intro-text">
          <p>You already know a good webinar can bring in clients. Running one, though, involves a long list of small jobs: registration pages, reminder emails, speaker logistics, AV, recordings and follow-up. At most firms those jobs fall to people who already have full workloads, so webinars happen whenever someone finds the time.</p>
          <p>Most of the lost value comes after the session. Follow-up emails go out late or not at all. Attendee lists stay in a Zoom export and never reach the CRM. The recording sits in a shared drive because no one had time to edit it.</p>
        </div>
      </div>

      <table class="compare">
        <thead>
          <tr>
            <th scope="col">Running it yourself</th>
            <th scope="col" class="canopy-col">With Canopy</th>
          </tr>
        </thead>
        <tbody>
          {COMPARISON.map(([diy, canopy]) => (
            <tr>
              <td data-label="Running it yourself">{diy}</td>
              <td data-label="With Canopy" class="canopy-col">
                <svg class="check" width="16" height="12" viewBox="0 0 16 12" aria-hidden="true"><path d="M1.5 6.5 L6 10.5 L14.5 1.5" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
                <span>{canopy}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="rule-line">Canopy runs every stage of the webinar, so your firm gets more value from each one.</p>
    </div>
    </section>

    <!-- 3. Before, during, after -->
    <section id="end-to-end" class="band dark">
    <div class="container section-stack">
      <Scrubber time="02:10" pct={22} tone="ink" />
      <div class="intro">
        <h2 class="display-m intro-title">We run all three stages of every webinar.</h2>
        <p class="intro-text">Most teams put their effort into the session itself. Attendance, though, depends mostly on what happens beforehand, and the business value depends mostly on what happens afterward. Canopy runs the operations at every stage, which is how each webinar ends up returning more.</p>
      </div>

      <div class="timeline" aria-hidden="true">
        <div class="tl-before">Before</div>
        <div class="tl-during">During</div>
        <div class="tl-after">After</div>
      </div>

      <div class="stages">
        {STAGES.map((stage) => (
          <div class:list={['stage-col', stage.id]}>
            <Icon name={STAGE_ICONS[stage.id]} size={56} class="stage-icon" />
            <div class="stage-head">
              <span class="stage-label">
                {stage.id === 'during' && <span class="dot stage-dot"></span>}
                {stage.name}
              </span>
              <h3>{stage.tagline}</h3>
            </div>
            <ul class="stage-list">
              {stage.items.map((item) => <li>{item}</li>)}
            </ul>
            <div class="division">
              <p><strong>Canopy runs:</strong> <span>{stage.canopyRuns}</span></p>
              <p><strong>You bring:</strong> <span>{stage.youBring}</span></p>
            </div>
          </div>
        ))}
      </div>

      <div class="rule-row">
        <a href="/how-it-works" class="text-cta ink-link">How it works, step by step</a>
      </div>
    </div>
    </section>

    <!-- 4. What each webinar produces -->
    <section id="the-return" class="band light">
      <div class="container section-stack">
        <Scrubber time="05:30" pct={46} />
        <div class="intro">
          <h2 class="display-m intro-title">One webinar, eight weeks of content.</h2>
          <p class="intro-text">After every session, we hand back a set of assets your team can use for weeks, including with prospects who didn't attend.</p>
        </div>
        <ul class="assets icons-white">
          {ASSETS.map((asset) => (
            <li class="asset">
              <Icon name={asset.icon} size={44} class="asset-icon" />
              <h3>{asset.name}</h3>
              <p>{asset.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. How it works -->
    <section id="how-it-works" class="band dark">
    <div class="container section-stack">
      <Scrubber time="07:00" pct={60} tone="ink" />
      <div class="intro">
        <h2 class="display-m intro-title">The same process for every webinar.</h2>
        <p class="intro-text">You'll always know what we need from you and by when.</p>
      </div>
      <ol class="steps">
        {STEPS.map((step, i) => (
          <li class:list={['step', { live: step.stage === 'during' }]}>
            <span class="step-marker" aria-hidden="true"><span class="step-dot"></span></span>
            <span class="step-n">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <div class="rule-row">
        <a href="/how-it-works" class="text-cta ink-link">See the full process</a>
      </div>
    </div>
    </section>

    <!-- 6. Pricing -->
    <section id="pricing" class="band light">
    <div class="container section-stack pricing">
      <Scrubber time="08:00" pct={70} />
      <div class="price-card">
        <div class="price-main">
          <div class="lockup"><Mark width={30} height={23} /><span>canopy</span></div>
          <div class="price-copy">
            <h2 class="price-heading">
              <span class="price">{PRICE_HEADLINE.price}</span>
              <span class="price-sub">{PRICE_HEADLINE.rest}</span>
            </h2>
            <p class="price-subhead">{PRICE_SUBHEAD}</p>
          </div>
          <div class="price-foot">
            <p class="price-meta">{FINE_PRINT}</p>
            <p class="price-setup"><strong>Setup includes:</strong> {SETUP_INCLUDES}</p>
            <div class="price-ctas">
              <a href="/book" class="btn btn-live btn-lg">Book a 20-minute call</a>
              <a href="/pricing" class="text-cta paper-link">Full pricing</a>
            </div>
          </div>
        </div>
        <div class="price-panel icons-ink">
          <h3 class="panel-label"><span class="dot"></span>Every month includes:</h3>
          <ul class="panel-list">
            {MONTHLY.map(([item, icon]) => <li><Icon name={icon} size={24} /><span>{item}</span></li>)}
          </ul>
        </div>
      </div>
    </div>
    </section>

    <!-- 7. Who it's for + FAQ -->
    <section id="fit" class="band dark">
      <div class="container section-stack">
        <Scrubber time="08:40" pct={84} tone="ink" />
        <div class="intro">
          <h2 class="display-m intro-title">For firms that already get results from webinars.</h2>
          <p class="intro-text">Canopy is for professional-services firms that have seen webinars lead to new work but can't run them on a regular schedule, usually because the logistics fall to people with full workloads.</p>
        </div>
        <div class="fit-row">
          <div class="fit-intro">
            <div class="fit-box">
              <h3>It's a fit if…</h3>
              <ul>
                {FIT.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
          <div class="faq">
            {FAQ.map(([q, a], i) => (
              <details open={i === 0}>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Closing CTA -->
    <Closing scrubber={{ time: '09:15', pct: 100 }} />
  </main>

  <Footer current="/" />
</Base>

<style>
  ul, ol { list-style: none; margin: 0; padding: 0; }

  /* Hero */
  .home-hero { gap: 28px; }
  .home-hero .hero-title { text-wrap: balance; }
  .home-hero .hero-lead { max-width: 640px; }
  .hero-values { display: flex; flex-direction: column; gap: 10px; margin-top: -8px; }
  .hero-values li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    align-items: baseline;
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.3;
  }
  .hero-check { color: var(--fern); transform: translateY(1px); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 4px; }
  .hero-link, .hero-link:hover { color: var(--paper); font-size: 17px; }


  /* Hero card */
  .stage-card li { border-top: 1px solid var(--moss); }
  .stage-card li:last-child { border-bottom: 1px solid var(--moss); }
  .stage-row {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    padding: 24px 0;
    color: var(--paper);
    text-decoration: none;
    align-items: start;
  }
  .stage-text { display: flex; flex-direction: column; gap: 6px; }
  .stage-name { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .stage-summary { font-size: var(--text-small); color: var(--sage); line-height: 1.45; }

  /* Bands: homepage sections alternate light and dark */
  .band {
    --fg: var(--ink);
    --muted: var(--stone);
    --body: var(--moss);
    --rule: var(--line);
    --rule-heavy: var(--ink);
    background: var(--paper);
    color: var(--fg);
  }
  .band.dark {
    --fg: var(--paper);
    --muted: var(--sage);
    --body: var(--sage);
    --rule: var(--moss);
    --rule-heavy: var(--paper);
    background: var(--ink);
  }

  /* Section intros */
  .intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 48px;
  }
  .intro-title { max-width: 720px; }
  .intro-text { margin: 0; max-width: 440px; font-size: var(--text-body); line-height: 1.5; color: var(--body); }
  .intro-text p { margin: 0; }
  .intro-text p + p { margin-top: 16px; }
  #the-math .intro { align-items: flex-start; }
  #the-math .intro-text { max-width: 520px; }

  .rule-line,
  .rule-row {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 8px;
    border-top: 2px solid var(--rule-heavy);
  }
  .rule-line { font-size: clamp(19px, 1.8vw, 24px); font-weight: 700; letter-spacing: -0.015em; padding-top: 16px; }
  .rule-row { justify-content: flex-end; }
  .ink-link, .ink-link:hover { color: var(--fg); font-size: 17px; }

  /* The math: comparison table */
  .compare { width: 100%; border-collapse: collapse; font-size: 17px; line-height: 1.4; }
  .compare th {
    text-align: left;
    padding: 18px 20px;
    font-size: clamp(19px, 1.8vw, 24px);
    font-weight: 700;
    letter-spacing: -0.015em;
    background: var(--white);
    border-bottom: 3px solid var(--ink);
    width: 50%;
  }
  .compare th.canopy-col { background: var(--canopy); color: var(--paper); border-bottom-color: var(--live); }
  .compare td { padding: 16px 20px; background: var(--white); color: var(--stone); border-top: 1px solid var(--line); }
  .compare td.canopy-col {
    background: var(--canopy);
    color: var(--paper);
    font-weight: 600;
    border-top-color: var(--line-green);
  }
  .compare td.canopy-col { display: flex; gap: 12px; align-items: baseline; }
  .check { flex: none; color: var(--fern); transform: translateY(1px); }

  @media (max-width: 719px) {
    .compare thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .compare, .compare tbody, .compare tr { display: block; }
    .compare tr { margin-bottom: 12px; }
    .compare td { display: block; border-top: 0; padding: 14px 16px; }
    .compare td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 4px;
      font-size: var(--text-meta);
      font-weight: 600;
      color: var(--stone);
    }
    .compare td.canopy-col { display: grid; grid-template-columns: 16px 1fr; column-gap: 12px; }
    .compare td.canopy-col::before { grid-column: 1 / -1; color: var(--fern); }
  }

  /* Before, during, after */
  .timeline { display: flex; height: 72px; font-weight: 700; font-size: clamp(16px, 1.6vw, 22px); letter-spacing: -0.01em; }
  .timeline > div { display: flex; align-items: center; padding: 0 clamp(12px, 2vw, 24px); }
  .tl-before { flex: 5; background: var(--fern); color: var(--ink); }
  .tl-during { flex: 0 0 auto; background: var(--live); color: var(--ink); }
  .tl-after { flex: 6; background: var(--canopy); color: var(--paper); }

  .stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 24px;
  }
  .stage-col {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    --rule: var(--line);
    --muted: var(--stone);
    --foot: var(--fern);
  }
  .stage-col.before { background: var(--white); color: var(--ink); border-top: 6px solid var(--fern); }
  /* Icon colors per column background (ICONS.md) */
  .stage-col.before { --icon-primary: var(--canopy); --icon-secondary: #8FB39B; --icon-cutout: var(--white); }
  .stage-col.during { --icon-primary: var(--paper); --icon-secondary: var(--line-green); --icon-cutout: var(--ink); }
  .stage-col.after { --icon-primary: var(--paper); --icon-secondary: #8FB39B; --icon-cutout: var(--canopy); }
  .stage-icon { margin-bottom: -4px; }
  .stage-col.during { background: var(--ink); color: var(--paper); border: 1px solid var(--moss); border-top: 6px solid var(--live); --rule: var(--moss); --muted: var(--sage); --foot: var(--field); }
  .stage-col.after { background: var(--canopy); color: var(--paper); border-top: 6px solid var(--ink); --rule: var(--line-green); --muted: var(--fern); --foot: var(--canopy-shade); }
  .stage-head { display: flex; flex-direction: column; gap: 6px; }
  .stage-label { font-size: var(--text-label); font-weight: 600; color: var(--muted); display: flex; align-items: center; gap: 8px; }
  .during .stage-label { color: var(--live); }
  .stage-dot { width: 8px; height: 8px; }
  .stage-col h3 { margin: 0; font-size: 30px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .stage-list { display: flex; flex-direction: column; font-size: 17px; line-height: 1.35; }
  .stage-list li { padding: 11px 0; border-top: 1px solid var(--rule); }
  .stage-list li:last-child { border-bottom: 1px solid var(--rule); }

  /* Who does what: the same two-row block at the foot of every column */
  .division {
    margin: auto -28px -28px;
    padding: 18px 28px 22px;
    background: var(--foot);
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--text-label);
    line-height: 1.4;
  }
  .division p { margin: 0; display: grid; grid-template-columns: 108px 1fr; gap: 12px; }
  .division strong { font-weight: 700; }
  .division p:first-child strong { color: var(--muted); font-weight: 600; }

  /* The return */
  .assets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .asset {
    background: var(--white);
    padding: 22px 20px 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (min-width: 600px) {
    .asset { min-height: 220px; }
  }
  .asset-icon { margin-bottom: 4px; }
  .asset h3 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.015em; }
  .asset p { margin: 0; font-size: var(--text-small); line-height: 1.5; color: var(--stone); }

  /* Run-of-show: vertical by default, horizontal on wide screens */
  .steps { display: grid; grid-template-columns: 1fr; }
  .step {
    position: relative;
    padding: 0 0 32px 36px;
    border-left: 3px solid var(--rule-heavy);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .step:last-child { border-left-color: transparent; padding-bottom: 0; }
  .step-marker { position: absolute; left: -10px; top: 2px; }
  .step-dot { display: block; width: 17px; height: 17px; border-radius: 50%; background: var(--ink); border: 3px solid var(--paper); }
  .step.live .step-dot { background: var(--live); border-color: var(--live); }
  .step-n { font-size: var(--text-label); font-weight: 600; color: var(--muted); }
  .step.live .step-n { color: var(--live); }
  .step h3 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.015em; line-height: 1.15; }
  .step p { margin: 0; font-size: var(--text-small); line-height: 1.5; color: var(--body); max-width: 560px; }

  @media (min-width: 1024px) {
    .steps { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0 24px; border-top: 3px solid var(--rule-heavy); }
    .step, .step:last-child { padding: 28px 0 0; border-left: 0; }
    .step-marker { left: 0; top: -10px; }
  }

  /* Pricing */
  .price-card {
    background: var(--canopy);
    color: var(--paper);
    padding: clamp(24px, 4vw, 52px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }
  .price-main { flex: 999 1 420px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }
  .lockup { display: flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 800; letter-spacing: var(--tracking-wordmark); }
  .price-copy { display: flex; flex-direction: column; gap: 20px; }
  .price-heading { margin: 0; display: flex; flex-direction: column; gap: 12px; font-weight: 800; }
  .price { font-size: clamp(64px, 9vw, 128px); letter-spacing: -0.055em; line-height: 0.88; }
  .price-sub { font-size: clamp(24px, 2.4vw, 34px); font-weight: 700; letter-spacing: -0.02em; }
  .price-subhead { margin: 0; max-width: 560px; font-size: var(--text-body); line-height: 1.5; color: var(--fern); }
  .price-foot { display: flex; flex-direction: column; gap: 14px; }
  .price-meta { margin: 0; font-size: 17px; font-weight: 600; }
  .price-setup { margin: 0; max-width: 600px; font-size: var(--text-label); line-height: 1.5; color: var(--fern); }
  .price-setup strong { color: var(--paper); }
  .price-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 12px; }
  .paper-link, .paper-link:hover { color: var(--paper); font-size: 17px; }
  .price-panel {
    flex: 1 1 260px;
    background: var(--ink);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .panel-label { margin: 0; display: flex; align-items: center; gap: 8px; font-size: var(--text-label); font-weight: 600; }
  .panel-list { display: flex; flex-direction: column; font-size: var(--text-small); line-height: 1.4; color: var(--sage); }
  .panel-list li { padding: 10px 0; border-top: 1px solid var(--moss); display: flex; align-items: center; gap: 12px; }
  .panel-list li:last-child { border-bottom: 1px solid var(--moss); }

  /* Fit + FAQ */
