---
import Base from '../layouts/Base.astro';
import SplitHero from '../components/SplitHero.astro';
import Scrubber from '../components/Scrubber.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import { RENEWAL_TERMS } from '../config';
import { FAQ as SHARED_FAQ } from '../data/faq';
import { PRICE_HEADLINE, PRICE_SUBHEAD, FINE_PRINT, SETUP_INCLUDES, MONTHLY } from '../data/pricing';

const NUMBERS = [
  { value: '$2,500', label: 'per month, one webinar', big: true },
  { value: '$2,000', label: 'one-time setup' },
  { value: '3 months', label: 'initial term' },
];

// The shared FAQ plus the two pricing-specific questions.
const FAQ: [string, string][] = [
  ...SHARED_FAQ,
  ['What does the setup fee cover?', "Onboarding, your branded landing and registration pages, Zoom Webinar configuration, email workflows and reporting infrastructure. It's paid once."],
  ['How long do we commit for?', `The initial contract is three months. ${RENEWAL_TERMS}`],
];
---
<Base
  title="Pricing — Canopy"
  description="$2,500 a month for one fully run webinar, Zoom Webinar included. $2,000 one-time setup, three-month initial term."
  path="/pricing"
>
  <SplitHero current="/pricing">
    <div class="hero-body">
      <h1 class="hero-title pricing-title">
        <span class="title-price">{PRICE_HEADLINE.price}</span>
        <span class="title-rest">{PRICE_HEADLINE.rest}</span>
      </h1>
      <p class="hero-lead">{PRICE_SUBHEAD}</p>
    </div>

    <div slot="rail" class="rail-list">
      <span class="rail-label">The numbers</span>
      {NUMBERS.map((n) => (
        <div class="number">
          <span class:list={['number-value', { big: n.big }]}>{n.value}</span>
          <span class="number-label">{n.label}</span>
        </div>
      ))}
    </div>
  </SplitHero>

  <main>
    <section class="container stack">
      <Scrubber time="08:00" label="The investment" pct={30} />
      <div class="get-card">
        <div class="get-main">
          <h2 class="get-title">Every month includes:</h2>
          <ul class="monthly">
            {MONTHLY.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="setup-panel">
          <div class="setup-head">
            <span class="setup-label">{FINE_PRINT}</span>
            <h3>Setup includes:</h3>
            <p class="setup-text">{SETUP_INCLUDES}</p>
          </div>
          <a href="/book" class="btn btn-live btn-md setup-cta">Book a 20-minute call</a>
        </div>
      </div>
    </section>

    <section class="qa">
      <div class="container stack">
        <Scrubber time="08:40" label="Q&A" pct={75} />
        <div class="qa-row">
          <h2 class="display-m qa-title">Questions from the chat.</h2>
          <div class="faq">
            {FAQ.map(([q, a], i) => (
              <details open={i === 0}>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <Closing />
  </main>

  <Footer current="/pricing" />
</Base>

<style>
  ul { list-style: none; margin: 0; padding: 0; }

  /* Rail: the numbers */
  .number { display: flex; flex-direction: column; gap: 4px; padding: 22px 0; border-top: 1px solid var(--moss); }
  .number:last-child { border-bottom: 1px solid var(--moss); }
  .number-value { font-size: 32px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
  .number-value.big { font-size: 48px; font-weight: 800; letter-spacing: var(--tracking-display); }
  .number-label { font-size: var(--text-small); color: var(--sage); }

  .stack { display: flex; flex-direction: column; gap: 40px; }

  /* What you get */
  .get-card {
    background: var(--canopy);
    color: var(--paper);
    padding: clamp(24px, 4vw, 52px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }
  .get-main { flex: 999 1 460px; display: flex; flex-direction: column; gap: 28px; }
  .get-title { margin: 0; font-size: clamp(36px, 4.5vw, 64px); line-height: 0.95; font-weight: 800; letter-spacing: var(--tracking-display); }
  .monthly {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 0 32px;
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .monthly li { padding: 12px 0; border-top: 1px solid var(--line-green); }
  .monthly { border-bottom: 1px solid var(--line-green); }

  .setup-panel {
    flex: 1 1 280px;
    background: var(--ink);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  .setup-head { display: flex; flex-direction: column; gap: 8px; }
  .setup-label { font-size: var(--text-label); font-weight: 600; color: var(--sage); }
  .setup-head h3 { margin: 8px 0 0; font-size: 28px; font-weight: 800; letter-spacing: -0.03em; }
  .setup-text { margin: 0; font-size: var(--text-small); line-height: 1.5; color: var(--sage); }
  .pricing-title { display: flex; flex-direction: column; gap: 16px; }
  .title-rest { font-size: clamp(28px, 3.2vw, 48px); line-height: 1; letter-spacing: -0.03em; }
  .setup-cta { align-self: flex-start; }

  /* Q&A */
  .qa { background: var(--white); border-top: 1px solid var(--line); }
  .qa-row { display: flex; flex-wrap: wrap; gap: 48px; }
  .qa-title { flex: 1 1 300px; }
  .faq { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; border-top: 3px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); padding: 20px 0; }
  summary {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.015em;
    min-height: 32px;
    cursor: pointer;
  }
  details p { margin: 12px 0 0; font-size: 17px; line-height: 1.55; color: var(--moss); max-width: 640px; }
</style>
