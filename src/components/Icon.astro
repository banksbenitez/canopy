---
// Inlines a Canopy brand icon from src/assets/icons (see canopy-icons-kit/docs/ICONS.md).
// Colors come from --icon-primary / --icon-secondary / --icon-cutout, set per
// section background with the .icons-* classes in global.css. Always decorative.
import type { IconName } from '../data/icons';

const SOURCES = import.meta.glob<string>('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const ICONS = Object.fromEntries(
  Object.entries(SOURCES).map(([path, svg]) => [path.split('/').pop()!.replace('.svg', ''), svg]),
);


interface Props {
  name: IconName;
  /** Rendered width and height in px */
  size: number;
  /** Recolor the orange live dot to --icon-primary, for uses that aren't live */
  noLive?: boolean;
  class?: string;
}

const { name, size, noLive = false, class: className } = Astro.props;
const source = ICONS[name];
if (!source) throw new Error(`Unknown icon: ${name}`);

let inner = source.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
if (noLive) inner = inner.replaceAll('fill:#F0562B', 'fill:var(--icon-primary,#265B42)');
---
<svg
  class:list={['icon', className]}
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>

<style>
  .icon { display: block; flex: none; }
</style>
